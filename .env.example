# X Automation Bot — Environment Variables
# Copy this file to .env and fill in your values.

# Encryption key for stored credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Default X API credentials (optional — can also be added per-account via dashboard)
# Get these from https://developer.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Gemini API Key (optional — for AI-generated captions)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server settings
HOST=0.0.0.0
PORT=8000
